# Order Service — Environment Variables
AUTH_SERVICE_URL=http://localhost:8080
DATABASE_DSN="host=localhost user=admin password=password dbname=order_db port=5432 sslmode=disable"
REDIS_DSN=redis://localhost:6379/1
RABBIT_MQ_URL=amqp://admin:password@localhost:5672/
PORT=8084
CATALOG_GRPC_URL=localhost:50051
# MinIO / S3 for invoice storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_BUCKET_NAME=ecommerce-invoices
