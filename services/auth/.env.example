# Auth Service — Environment Variables
# Copy this to .env and fill in your values

ENV_TYPE="prod"

# Database
POSTGRES_DSN="host=localhost user=admin password=password dbname=auth_db port=5432 sslmode=disable"

# RSA Key Paths (generate with openssl — see README)
PRIVATE_PEM_PATH="./cmd/secrets/private.pem"
PUBLIC_PEM_PATH="./cmd/secrets/public.pem"

# Internal service URLs
EMAIL_SERVICE_BASE_URL=http://localhost:8081/api/v1/email

# Google OAuth 2.0 (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Frontend URL (for OAuth redirect after login)
FRONTEND_URL=http://localhost:3000

# RabbitMQ
RABBITMQ_URL=amqp://admin:password@localhost:5672/
