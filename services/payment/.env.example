# Payment Service — Environment Variables
# Get Stripe keys from dashboard.stripe.com
PAYMENT_GATEWAY_SECRET_KEY=sk_test_your_stripe_secret_key_here
DATABASE_DSN="host=localhost user=admin password=password dbname=payment_db port=5432 sslmode=disable"
RABBIT_MQ_URL=amqp://admin:password@localhost:5672/
# Get from: stripe listen --forward-to localhost:8085/api/v1/payment/webhook
WEBHOOK_SECRET_KEY=whsec_your_stripe_webhook_secret_here
